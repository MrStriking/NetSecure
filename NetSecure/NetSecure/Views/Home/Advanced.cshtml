<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="~/LabSelect.css">
    <title>Choose Your Lab</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous"></script>

</head>
@{
    var finishedLabs = ViewBag.LabProgress as List<string> ?? new List<string>();
    var isDone1 = finishedLabs.Contains("ALab1");
    var isDone2 = finishedLabs.Contains("ALab2");
    var isDone3 = finishedLabs.Contains("ALab3");
}
<body>
    <header>
        <h1>Choose Your Lab</h1>
    </header>

    <section class="labs">
        <form method="post" action="/home/Advanced/selectlab">
            <button class="lab-box lab1" name="lab" value="ALab1" type="submit">
                <h2>Lab 1</h2>
                <p style="font-size: 0.9em; color: @(isDone1 ? "green" : "red")">
                    @(isDone1 ? "Finished" : "Not Finished")
                </p>
            </button>
        </form>
    </section>
    <section>
        <button onclick="location.href='@Url.Action("ResetProgress", "Home")'" style="padding: 15px 30px;
    font-size: 16px;
    font-weight: bold;
    background-color: #021496;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease-in-out;">
            Reset All Progress
        </button>
    </section>
    <footer>
        <p>&copy; 2024 NetSecure | All Rights Reserved</p>
    </footer>
</body>
</html>
