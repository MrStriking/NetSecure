</head>
<body>
    <header>
        <h1>Choose Your Lab</h1>
    </header>

    <section class="labs">
        <form method="post" action="/home/Advanced/selectlab">
            <button class="lab-box lab1" name="lab" value="ALab1" type="submit">
                <h2>Lab 1</h2>
            </button>
        </form>

        <form method="post" action="/home/Advanced/selectlab">
            <button class="lab-box lab2" name="lab" value="ALab2" type="submit">
                <h2>Lab 2</h2>
            </button>
        </form>

        <form method="post" action="/home/Advanced/selectlab">
            <button class="lab-box lab3" name="lab" value="ALab3" type="submit">
                <h2>Lab 3</h2>
            </button>
        </form>
    </section>

    <footer>
