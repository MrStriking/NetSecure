<section class="setup">
    <h2>🛠️ Lab1 Setup: Building Your First Network</h2>
    <p class="intro-text">
        Let's build a simple network together! Follow these easy steps to create your first working network in GNS3.
    </p>

    <div class="setup-step">
        <div class="step-header">
            <span class="step-number">1</span>
            <h3>Create Your Project</h3>
        </div>
        <div class="step-content">
            <div class="instruction-card">
                <div class="instruction-icon">💻</div>
                <div class="instruction-text">
                    <strong>Open GNS3</strong> and click <span class="highlight">New Project</span>
                </div>
            </div>
            <div class="instruction-card">
                <div class="instruction-icon">✏️</div>
                <div class="instruction-text">
                    Name your project: <span class="code">BLab1</span>
                </div>
            </div>
            <div class="visual-guide">
                <p><strong>Add these devices:</strong></p>
                <div class="device-grid">
                    <div class="device-item">
                        <div class="device-icon">🔀</div>
                        <div>1 Ethernet Switch</div>
                    </div>
                    <div class="device-item">
                        <div class="device-icon">🖥️</div>
                        <div>2 VPCS (Virtual PCs)</div>
                    </div>
                </div>
            </div>
            <div class="connection-guide">
                <p><strong>Make connections:</strong></p>
                <div class="connection-visual">
                    <div class="connection-line">
                        <span>PC1</span> <span class="arrow">→</span> <span>Switch</span>
                    </div>
                    <div class="connection-line">
                        <span>PC2</span> <span class="arrow">→</span> <span>Switch</span>
                    </div>
                </div>
                <p class="tip">Use the <span class="tooltip">"Add a Link"</span> tool to connect devices</p>
            </div>
        </div>
    </div>

    <div class="setup-step">
        <div class="step-header">
            <span class="step-number">2</span>
            <h3>Configure Your Devices</h3>
        </div>
        <div class="step-content">
            <div class="instruction-card important">
                <div class="instruction-icon">⏯️</div>
                <div class="instruction-text">
                    First, <strong>right-click</strong> each PC and select <span class="highlight">Start</span>
                </div>
            </div>

            <div class="config-section">
                <div class="device-config">
                    <h4>PC1 Configuration</h4>
                    <div class="code-block">
                        <div class="code-header">Enter this command:</div>
                        <code>ip 192.168.1.2 255.255.255.0</code>
                    </div>
                </div>

                <div class="device-config">
                    <h4>PC2 Configuration</h4>
                    <div class="code-block">
                        <div class="code-header">Enter this command:</div>
                        <code>ip 192.168.1.3 255.255.255.0</code>
                    </div>
                </div>
            </div>

            <div class="verification">
                <p>To check your settings on either PC:</p>
                <div class="code-block">
                    <code>show ip</code>
                </div>
                <p class="tip">You should see the IP address you assigned</p>
            </div>
        </div>
    </div>

    <div class="setup-step">
        <div class="step-header">
            <span class="step-number">3</span>
            <h3>Test Your Connection</h3>
        </div>
        <div class="step-content">
            <div class="test-instruction">
                <p>Let's make sure everything is working!</p>

                <div class="test-command">
                    <p>From <strong>PC1</strong> console:</p>
                    <div class="code-block">
                        <code>ping 192.168.1.3</code>
                    </div>
                </div>

                <div class="test-command">
                    <p>From <strong>PC2</strong> console:</p>
                    <div class="code-block">
                        <code>ping 192.168.1.2</code>
                    </div>
                </div>

                <div class="success-message">
                    <div class="success-icon">✅</div>
                    <div>
                        <strong>Success looks like:</strong> Reply from 192.168.1.x: bytes=32 time=1ms TTL=64
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="completion-message">
        <h3>🎉 Congratulations!</h3>
        <p>You've successfully built your first network in GNS3!</p>
        <div class="next-steps">
            <p><strong>Next:</strong> Click "EVALUATE LAB" to check your work</p>
        </div>
    </div>
</section>



